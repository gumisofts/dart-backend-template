# Copy this file to .env and fill in the values.
# .env is gitignored; never commit secrets.

# Server
PORT=8000

# JSON Web Token. Required: the server refuses to start without a secret of
# at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_DAYS=30

# Admin panel (GisilaStudio) at /studio. Leave the password empty to keep
# the studio disabled; it needs at least 12 characters.
STUDIO_USERNAME=admin
STUDIO_PASSWORD=
